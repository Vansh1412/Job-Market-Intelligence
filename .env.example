# =============================================================================
# JobIntel — Unified Job Market Intelligence Platform
# Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and adjust variables for your target deployment environment.
# DO NOT commit real secrets or production .env files to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME ENVIRONMENT
# Options: development | testing | production
# -----------------------------------------------------------------------------
JOBINTEL_ENV=development

# -----------------------------------------------------------------------------
# BACKEND API CONFIGURATION (FastAPI / Uvicorn)
# -----------------------------------------------------------------------------
JOBINTEL_HOST=0.0.0.0
JOBINTEL_PORT=8000
JOBINTEL_LOG_LEVEL=info
JOBINTEL_WORKERS=1

# -----------------------------------------------------------------------------
# CORS SECURITY SETTINGS
# Comma-separated list of allowed origin URLs for browser clients.
# Use specific domains in production (e.g., https://jobintel.app).
# -----------------------------------------------------------------------------
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Production example:
# CORS_ORIGINS=https://jobintel.company.com,https://app.jobintel.com

# -----------------------------------------------------------------------------
# FRONTEND APPLICATION CONFIGURATION (Vite / React)
# -----------------------------------------------------------------------------
# Base URL for API requests. In development, Vite dev server proxies /api to backend.
# In production, set to full API domain or keep relative if served behind reverse proxy.
VITE_API_BASE_URL=/api

# -----------------------------------------------------------------------------
# RESEARCH & MODEL GOVERNANCE
# Verification flag enforcing SHA-256 integrity validation on startup.
# -----------------------------------------------------------------------------
ENFORCE_MODEL_HASH_VERIFICATION=true
