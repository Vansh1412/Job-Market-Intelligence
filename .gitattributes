# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure JSON, code, and documentation always check out with LF
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary artifacts must never undergo line-ending normalization
*.pkl binary
*.joblib binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
